// PCSX2's TFX shader selector compiles TME=0 into a sampler-free program.
// GXM has no runtime compiler, so keep this high-volume family as an offline
// variant while sharing the exact alpha/fog/RTA/output arithmetic.
#define VITASX2_TFX_FAST 1
#define VITASX2_TFX_UNTEXTURED 1
#include "vitasx2_tfx_f.cg"
