			const bool valid = (control & validBit) != 0u &&
				((upperAccess1 >> 19u) & 31u) == 0u &&
				upperPipe <= 1u && lowerPipe <= 6u &&
				viBackupRegisterForPair < 16u &&
				(viBackupWrite || viBackupRegisterForPair == 0u) &&
				(lowerPipe != 4u || lowerLatency >= 0) &&
				(!lowerQpPipe || lowerLatency >= 0) &&
				validFdivMetadata && validEfuMetadata;
			const bool executeUpper = (control & executeUpperBit) != 0u;
			const bool executeLower = (control & executeLowerBit) != 0u;
			const bool immediateLower =
				(control & immediateLowerBit) != 0u;
			const bool lowerDiscarded =
				(control & lowerDiscardedBit) != 0u;
			const bool supportedQArithmetic = !approximateQ ||
				(lowerKind != 53u && lowerKind != 55u);
			const bool supportedPArithmetic = approximateP ||
				(lowerKind != 58u && lowerKind != 65u);
			const bool supportedLower = immediateLower || !executeLower ||
				lowerDiscarded || lowerKind == 1u || lowerKind == 2u ||
				lowerKind == 3u || lowerKind == 4u ||
				lowerKind == 5u || lowerKind == 6u ||
				lowerKind == 13u ||
				(lowerKind >= 19u && lowerKind <= 27u) ||
				(lowerKind >= 28u && lowerKind <= 33u) ||
				(lowerKind >= 38u && lowerKind <= 50u) ||
				lowerKind == 51u || lowerKind == 52u ||
				((lowerKind >= 53u && lowerKind <= 57u) &&
					supportedQArithmetic) ||
				((lowerKind == 58u || lowerKind == 65u) &&
					supportedPArithmetic);

			// D/T remain CPU observation boundaries. XGKICK is admitted only by
			// the bounded raw-PATH1 route below, which retains the one-following-
			// pair delay used by PCSX2's normal microVU provider.
			#pragma branch (flatten: never)
			if (!valid)
			{
				stopReason = 2u;
			}
			else if (((control & dBit) != 0u && (fbrst & 0x400u) != 0u) ||
				((control & tBit) != 0u && (fbrst & 0x800u) != 0u))
