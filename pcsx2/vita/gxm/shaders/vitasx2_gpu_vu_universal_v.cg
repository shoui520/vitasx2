					if (!instantQp && lowerEfuPipe && efuEnabled != 0u &&
						(!assumeScheduled || explicitWaitP))
					{
						if (efuReady != 0u)
							efuReady--;
							vuCycle = VuMaxU(vuCycle, efuReady);
						}
#endif

					// _vuTestPipes() retires every now-visible queue head after all
				// source/resource stalls. Entries are issue ordered, so four bounded
				// shifts exactly reproduce the canonical rings.
				if (fmacCount > 0u && fmacReady.x <= vuCycle)
				{
					fmacReady = fmacReady.yzww;
					fmacUpperWriter = fmacUpperWriter.yzww;
					fmacLowerWriter = fmacLowerWriter.yzww;
					fmacCount--;
				}
				if (fmacCount > 0u && fmacReady.x <= vuCycle)
				{
					fmacReady = fmacReady.yzww;
					fmacUpperWriter = fmacUpperWriter.yzww;
					fmacLowerWriter = fmacLowerWriter.yzww;
					fmacCount--;
				}
				if (fmacCount > 0u && fmacReady.x <= vuCycle)
				{
					fmacReady = fmacReady.yzww;
					fmacUpperWriter = fmacUpperWriter.yzww;
					fmacLowerWriter = fmacLowerWriter.yzww;
					fmacCount--;
				}
				if (fmacCount > 0u && fmacReady.x <= vuCycle)
				{
					fmacReady = fmacReady.yzww;
					fmacUpperWriter = fmacUpperWriter.yzww;
					fmacLowerWriter = fmacLowerWriter.yzww;
					fmacCount--;
				}
				if (ialuCount > 0u && ialuReady.x <= vuCycle)
				{
					ialuReady = ialuReady.yzww;
					ialuWriterMask = ialuWriterMask.yzww;
					ialuCount--;
				}
				if (ialuCount > 0u && ialuReady.x <= vuCycle)
				{
					ialuReady = ialuReady.yzww;
					ialuWriterMask = ialuWriterMask.yzww;
					ialuCount--;
				}
				if (ialuCount > 0u && ialuReady.x <= vuCycle)
				{
					ialuReady = ialuReady.yzww;
					ialuWriterMask = ialuWriterMask.yzww;
					ialuCount--;
				}
					if (ialuCount > 0u && ialuReady.x <= vuCycle)
					{
						ialuReady = ialuReady.yzww;
						ialuWriterMask = ialuWriterMask.yzww;
						ialuCount--;
					}
					if (fdivEnabled != 0u && (instantQp || fdivReady <= vuCycle))
					{
