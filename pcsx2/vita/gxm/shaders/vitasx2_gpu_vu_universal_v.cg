// Fixed serial GPU-VU1 feasibility executor. PCSX2's VU interpreter and
// VitaVU::GpuPairPlan remain the semantic authorities. This validation shader
// intentionally covers representative dependent FMAC, VI, LSU, and branch
// families before product wiring; it is not ExactSupport and is compiled only
// by VITASX2_GPU_VU_UNIVERSAL_VALIDATION.

// The fixed sidecar leaves every family enabled. The asynchronous general
// generated tier prepends exact-source family defines before compiling this
// same semantic core, allowing ShaccCg to remove operation bodies absent from
// an uploaded microprogram without changing admission semantics.
#ifndef VITASX2_GPU_VU_COMPACT_CONTINUATION
#define VITASX2_GPU_VU_COMPACT_CONTINUATION 0
#endif
#ifndef VITASX2_GPU_VU_INLINE_UNPACK
#define VITASX2_GPU_VU_INLINE_UNPACK 0
#endif
#ifndef VITASX2_GPU_VU_IN_PLACE_PRIVATE_GENERATION
#define VITASX2_GPU_VU_IN_PLACE_PRIVATE_GENERATION 0
#endif
#ifndef VITASX2_GPU_VU_DUAL_PRIVATE_GENERATION
#define VITASX2_GPU_VU_DUAL_PRIVATE_GENERATION 0
#endif

#ifndef VITASX2_UNIVERSAL_PAIR_SLICE
#define VITASX2_UNIVERSAL_PAIR_SLICE 128
#endif

#ifndef VITASX2_GPU_VU_UPPER_NOP
#define VITASX2_GPU_VU_UPPER_NOP 1
#define VITASX2_GPU_VU_UPPER_ABS 1
#define VITASX2_GPU_VU_UPPER_FTOI 1
#define VITASX2_GPU_VU_UPPER_ITOF 1
#define VITASX2_GPU_VU_UPPER_FMAC 1
#define VITASX2_GPU_VU_UPPER_CLIP 1
#define VITASX2_GPU_VU_UPPER_OPMULA 1
#define VITASX2_GPU_VU_UPPER_OPMSUB 1
#define VITASX2_GPU_VU_LOWER_LQ 1
#define VITASX2_GPU_VU_LOWER_SQ 1
#define VITASX2_GPU_VU_LOWER_ILW 1
#define VITASX2_GPU_VU_LOWER_ISW 1
#define VITASX2_GPU_VU_LOWER_IADDI 1
#define VITASX2_GPU_VU_LOWER_FSAND 1
#define VITASX2_GPU_VU_LOWER_IALU 1
#define VITASX2_GPU_VU_LOWER_MOVE 1
#define VITASX2_GPU_VU_LOWER_MFIR 1
#define VITASX2_GPU_VU_LOWER_MTIR 1
#define VITASX2_GPU_VU_LOWER_BRANCH 1
#define VITASX2_GPU_VU_LOWER_MFP 1
#define VITASX2_GPU_VU_LOWER_WAIT 1
#define VITASX2_GPU_VU_LOWER_XITOP 1
#define VITASX2_GPU_VU_LOWER_XTOP 1
#define VITASX2_GPU_VU_LOWER_FDIV 1
#define VITASX2_GPU_VU_LOWER_XGKICK 1
#define VITASX2_GPU_VU_LOWER_ESADD 1
#define VITASX2_GPU_VU_LOWER_ERSADD 1
#define VITASX2_GPU_VU_LOWER_ESQRT 1
#endif

#pragma readwrite_buffer BUFFER6
#pragma readwrite_buffer BUFFER8
#pragma readwrite_buffer BUFFER9
#pragma readwrite_buffer BUFFER10
#if VITASX2_GPU_VU_IN_PLACE_PRIVATE_GENERATION
#pragma readwrite_buffer BUFFER1
#pragma readwrite_buffer BUFFER2
#pragma readwrite_buffer BUFFER3
#else
#pragma readwrite_buffer BUFFER11
#pragma readwrite_buffer BUFFER12
#pragma readwrite_buffer BUFFER13
#endif

// PCSX2 VUops.cpp::intToFloat<Offset>() converts a signed 32-bit lane with
// round-to-nearest-even and then applies an exact binary scale. SGX floating
// add/conversion does not provide that conversion contract for the complete
// signed range, so construct the IEEE-754 result with integer operations.
#if VITASX2_GPU_VU_UPPER_ITOF
unsigned int VuSignedIntToFloatBits(
	unsigned int sourceBits, unsigned int scaleShift)
{
	const unsigned int signLane = sourceBits >> 31u;
	const unsigned int magnitude =
		(sourceBits ^ (0u - signLane)) + signLane;
	if (magnitude == 0u)
		return 0u;

	unsigned int exponent = 0u;
	unsigned int leading = magnitude;
	if (leading >= 0x10000u)
	{
		leading >>= 16u;
		exponent += 16u;
	}
	if (leading >= 0x100u)
	{
		leading >>= 8u;
		exponent += 8u;
	}
	if (leading >= 0x10u)
	{
		leading >>= 4u;
		exponent += 4u;
	}
	if (leading >= 0x4u)
	{
		leading >>= 2u;
		exponent += 2u;
	}
	if (leading >= 0x2u)
		exponent += 1u;

	unsigned int significand;
	if (exponent <= 23u)
	{
		significand = magnitude << (23u - exponent);
	}
	else
	{
		const unsigned int discardedBits = exponent - 23u;
		const unsigned int discardedMask =
			(1u << discardedBits) - 1u;
		const unsigned int remainder = magnitude & discardedMask;
		const unsigned int halfway = 1u << (discardedBits - 1u);
		significand = magnitude >> discardedBits;
		if (remainder > halfway ||
			(remainder == halfway && (significand & 1u) != 0u))
		{
			significand += 1u;
			if (significand == 0x1000000u)
			{
				significand >>= 1u;
				exponent += 1u;
			}
		}
	}

	return (signLane << 31u) |
		((127u + exponent - scaleShift) << 23u) |
		(significand & 0x7fffffu);
}
#endif

// PCSX2 VUops.cpp::floatToInt<Offset>() first multiplies by the selected
// binary fixed-point scale, saturates any result with magnitude >= 2^31
// according to its sign bit, and otherwise truncates toward zero. Native SGX
// float-to-int conversion is not used: its complete-range and NaN behavior is
// not the PS2 contract. For normal inputs, the power-of-two scale changes only
// the exponent; subnormal inputs remain below one even at FTOI15.
#if VITASX2_GPU_VU_UPPER_FTOI
unsigned int VuFloatToSignedIntBits(
	unsigned int sourceBits, unsigned int scaleShift)
{
	const unsigned int signLane = sourceBits >> 31u;
	const unsigned int exponentField = (sourceBits >> 23u) & 0xffu;
	const unsigned int mantissa = sourceBits & 0x7fffffu;
	if (exponentField == 0u)
		return 0u;
	if (exponentField == 0xffu)
		return signLane != 0u ? 0x80000000u : 0x7fffffffu;

	const int scaledExponent =
		(int)exponentField - 127 + (int)scaleShift;
	if (scaledExponent < 0)
		return 0u;
	if (scaledExponent >= 31)
		return signLane != 0u ? 0x80000000u : 0x7fffffffu;

	const unsigned int significand = 0x800000u | mantissa;
	unsigned int magnitude;
	if (scaledExponent >= 23)
		magnitude = significand << (unsigned int)(scaledExponent - 23);
	else
		magnitude = significand >> (unsigned int)(23 - scaledExponent);
	return signLane != 0u ? 0u - magnitude : magnitude;
}
#endif

// PCSX2 owner: VUops.cpp::vuDouble().  The validation executor currently
// admits only VitaSX2's standard VU1 numeric tier (nearest, DAZ/FZ, standard
// overflow clamp), checked before the first command mutates state below.
#if VITASX2_GPU_VU_UPPER_FMAC || VITASX2_GPU_VU_UPPER_OPMULA || \
	VITASX2_GPU_VU_UPPER_OPMSUB || VITASX2_GPU_VU_LOWER_FDIV || \
	VITASX2_GPU_VU_LOWER_ESADD || VITASX2_GPU_VU_LOWER_ERSADD || \
	VITASX2_GPU_VU_LOWER_ESQRT
unsigned int VuNormalizeOperandBits(unsigned int bits)
{
	const unsigned int exponent = bits & 0x7f800000u;
	if (exponent == 0u)
		return bits & 0x80000000u;
	if (exponent == 0x7f800000u)
		return (bits & 0x80000000u) | 0x7f7fffffu;
	return bits;
}

unsigned int4 VuNormalizeOperandBits4(unsigned int4 bits)
{
	return unsigned int4(
		VuNormalizeOperandBits(bits.x),
		VuNormalizeOperandBits(bits.y),
		VuNormalizeOperandBits(bits.z),
		VuNormalizeOperandBits(bits.w));
}
#endif

// PCSX2 owner: VUflags.cpp::VU_MAC_UPDATE().  MAC stores zero/sign/
// underflow/overflow in four lane-shaped nibbles.  Result clamping and flag
// publication are one operation; inactive ordinary FMAC lanes are cleared by
// VuClearMacLane(), while OPMULA/OPMSUB deliberately preserve W.
#if VITASX2_GPU_VU_UPPER_FMAC || VITASX2_GPU_VU_UPPER_OPMULA || \
	VITASX2_GPU_VU_UPPER_OPMSUB
unsigned int VuMacUpdate(
	unsigned int bits, unsigned int laneShift, inout unsigned int macFlag)
{
	const unsigned int laneMask = 0x1111u << laneShift;
	macFlag &= ~laneMask;
	if ((bits & 0x80000000u) != 0u)
		macFlag |= 0x0010u << laneShift;

	const unsigned int magnitude = bits & 0x7fffffffu;
	if (magnitude == 0u)
	{
		macFlag |= 0x0001u << laneShift;
		return bits;
	}

	const unsigned int exponent = bits & 0x7f800000u;
	if (exponent == 0u)
	{
		macFlag |= 0x0101u << laneShift;
		return bits & 0x80000000u;
	}
	if (exponent == 0x7f800000u)
	{
		macFlag |= 0x1000u << laneShift;
		return (bits & 0x80000000u) | 0x7f7fffffu;
	}
	return bits;
}

void VuClearMacLane(unsigned int laneShift, inout unsigned int macFlag)
{
	macFlag &= ~(0x1111u << laneShift);
}

unsigned int VuStatusFromMac(unsigned int macFlag)
{
	unsigned int status = 0u;
	if ((macFlag & 0x000fu) != 0u) status |= 1u;
	if ((macFlag & 0x00f0u) != 0u) status |= 2u;
	if ((macFlag & 0x0f00u) != 0u) status |= 4u;
	if ((macFlag & 0xf000u) != 0u) status |= 8u;
	return status;
}
#endif

// PCSX2 owner: VUops.cpp::_vuCLIP().  This is signed ordering of the raw
// float words, not an SGX floating-point comparison.  The threshold sign is
// ignored; exponent-zero values select the largest denormal, and the six-bit
// result shifts through the architected 24-bit working history.
#if VITASX2_GPU_VU_UPPER_CLIP
unsigned int VuClipUpdate(
	unsigned int4 sourceBits, unsigned int thresholdBits,
	unsigned int clipFlag)
{
	const unsigned int threshold =
		(thresholdBits & 0x7f800000u) != 0u ?
		thresholdBits & 0x7fffffffu : 0x007fffffu;
	unsigned int result = (clipFlag << 6u) & 0x00ffffffu;
	const unsigned int3 magnitude = sourceBits.xyz & 0x7fffffffu;
	const bool3 exceeds = magnitude > threshold.xxx;
	const unsigned int3 weights =
		unsigned int3(0x01u, 0x04u, 0x10u) << (sourceBits.xyz >> 31u);
	const unsigned int3 selected = exceeds ? weights : 0u;
	result |= selected.x | selected.y | selected.z;
	return result;
}
#endif

#if VITASX2_GPU_VU_UPPER_FMAC
unsigned int VuMaxBits(unsigned int left, unsigned int right)
{
	const int signedLeft = (int)left;
	const int signedRight = (int)right;
	if (signedLeft < 0 && signedRight < 0)
		return signedLeft < signedRight ? left : right;
	return signedLeft < signedRight ? right : left;
}

unsigned int VuMinBits(unsigned int left, unsigned int right)
{
	const int signedLeft = (int)left;
	const int signedRight = (int)right;
	if (signedLeft < 0 && signedRight < 0)
		return signedLeft < signedRight ? right : left;
	return signedLeft < signedRight ? left : right;
}
#endif

bool VuWriterOverlaps(
	unsigned int writer, unsigned int readRegister, unsigned int readMask)
{
	return (writer & 0xffu) != 0u && (writer & 0xffu) == readRegister &&
		(((writer >> 8u) & 0xffu) & readMask) != 0u;
}

unsigned int VuMaxU(unsigned int left, unsigned int right)
{
	return left < right ? right : left;
}

unsigned int VuFmacDependencyReady(
	unsigned int upperWriter, unsigned int lowerWriter,
	unsigned int readyCycle, unsigned int read0, unsigned int read0Mask,
	unsigned int read1, unsigned int read1Mask)
{
	const bool read0Blocked = read0 != 0u &&
		(VuWriterOverlaps(upperWriter, read0, read0Mask) ||
		 VuWriterOverlaps(lowerWriter, read0, read0Mask));
	const bool read1Blocked = read1 != 0u &&
		(VuWriterOverlaps(upperWriter, read1, read1Mask) ||
		 VuWriterOverlaps(lowerWriter, read1, read1Mask));
	return read0Blocked || read1Blocked ? readyCycle : 0u;
}

#if VITASX2_GPU_VU_LOWER_MTIR || VITASX2_GPU_VU_LOWER_FDIV || \
	VITASX2_GPU_VU_LOWER_ESQRT
unsigned int VuSelectLaneBits(unsigned int4 bits, unsigned int lane)
{
	if (lane == 0u) return bits.x;
	if (lane == 1u) return bits.y;
	if (lane == 2u) return bits.z;
	return bits.w;
}
#endif

#if VITASX2_GPU_VU_LOWER_FDIV
float VuFloatFromBits(unsigned int bits)
{
	return bit_cast<float4>(unsigned int4(
		VuNormalizeOperandBits(bits), 0u, 0u, 0u)).x;
}

unsigned int VuBitsFromFloat(float value)
{
	return VuNormalizeOperandBits(
		bit_cast<unsigned int4>(float4(value, 0.0f, 0.0f, 0.0f)).x);
}
#endif

#if VITASX2_GPU_VU_LOWER_ESADD || VITASX2_GPU_VU_LOWER_ERSADD || \
	VITASX2_GPU_VU_LOWER_ESQRT
float VuRawFloatFromBits(unsigned int bits)
{
	return bit_cast<float4>(unsigned int4(bits, 0u, 0u, 0u)).x;
}

unsigned int VuRawBitsFromFloat(float value)
{
	return bit_cast<unsigned int4>(float4(value, 0.0f, 0.0f, 0.0f)).x;
}
#endif

// ARM ARM A8.6.371/A8.6.378 define the 8-bit VRECPE/VRSQRTE estimate
// algorithms.  The fixed 640-word BUFFER7 table contains the exact eight-bit
// estimate fields for reciprocal scaled inputs 256..511 followed by reciprocal-
// square-root scaled inputs 128..511.  These helpers apply the same AArch32
// non-fused VRECPS/VRSQRTS refinement sequence used by
// VitaVU::ApproximateReciprocal()/ApproximateSqrt() on Cortex-A9.  Raw
// float/integer crossings retain each architecturally rounded intermediate and
// prevent the shader compiler from contracting the multiply/subtract steps.
#if VITASX2_GPU_VU_LOWER_ERSADD
unsigned int VuArmApproximateReciprocalBits(
	unsigned int valueBits, unsigned int estimateField)
{
	const unsigned int signBits = valueBits & 0x80000000u;
	const unsigned int exponent = (valueBits >> 23u) & 0xffu;
	if (exponent == 0u)
		return valueBits;
	if (exponent == 0xffu || exponent >= 253u)
		return signBits;

	const unsigned int seedBits = signBits |
		((253u - exponent) << 23u) | (estimateField << 15u);
	const float value = VuRawFloatFromBits(valueBits);
	const float seed = VuRawFloatFromBits(seedBits);
	const float product = VuRawFloatFromBits(
		VuRawBitsFromFloat(value * seed));
	const float refinementStep = VuRawFloatFromBits(
		VuRawBitsFromFloat(2.0f - product));
	return VuRawBitsFromFloat(seed * refinementStep);
}
#endif

#if VITASX2_GPU_VU_LOWER_ESQRT
unsigned int VuArmApproximateSqrtBits(
	unsigned int valueBits, unsigned int estimateField)
{
	const unsigned int exponent = (valueBits >> 23u) & 0xffu;
	if ((valueBits & 0x7fffffffu) == 0u || exponent == 0xffu)
		return valueBits;

	const unsigned int seedBits =
		(((380u - exponent) >> 1u) << 23u) |
		(estimateField << 15u);
	const float value = VuRawFloatFromBits(valueBits);
	const float seed = VuRawFloatFromBits(seedBits);
	const float seedSquare = VuRawFloatFromBits(
		VuRawBitsFromFloat(seed * seed));
	const float product = VuRawFloatFromBits(
		VuRawBitsFromFloat(value * seedSquare));
	const float difference = VuRawFloatFromBits(
		VuRawBitsFromFloat(3.0f - product));
	const float refinementStep = VuRawFloatFromBits(
		VuRawBitsFromFloat(difference * 0.5f));
	const float refined = VuRawFloatFromBits(
		VuRawBitsFromFloat(seed * refinementStep));
	return VuRawBitsFromFloat(value * refined);
}
#endif

#if VITASX2_GPU_VU_LOWER_ESADD || VITASX2_GPU_VU_LOWER_ERSADD
unsigned int VuEfuSumXyzSquaresBits(unsigned int4 sourceBits)
{
	const unsigned int4 normalized = VuNormalizeOperandBits4(sourceBits);
	const float x = VuRawFloatFromBits(normalized.x);
	const float y = VuRawFloatFromBits(normalized.y);
	const float z = VuRawFloatFromBits(normalized.z);
	const float xSquare = VuRawFloatFromBits(VuRawBitsFromFloat(x * x));
	const float ySquare = VuRawFloatFromBits(VuRawBitsFromFloat(y * y));
	const float zSquare = VuRawFloatFromBits(VuRawBitsFromFloat(z * z));
	const float xy = VuRawFloatFromBits(
		VuRawBitsFromFloat(xSquare + ySquare));
	return VuRawBitsFromFloat(xy + zSquare);
}
#endif

#if VITASX2_GPU_VU_LOWER_FDIV
unsigned int VuAbsBits(unsigned int bits)
{
	return bits & 0x7fffffffu;
}
#endif

unsigned int VuMergeFdivStatus(unsigned int statusFlag, unsigned int fdivStatus)
{
	return (statusFlag & 0x0fcfu) | (fdivStatus & 0x0c30u);
}

// UniversalPairMicroOp is eleven words. Keeping the source as a flat word
// buffer prevents Cg structure padding from changing the 44-byte CPU format.
// Words 3..10 are PCSX2 PairPlan dependency/pipeline metadata. The execution
// body consumes them for FMAC/IALU stall timing and the VI branch-visibility
// window. Delayed flag queues remain the next ExactSupport boundary. The
// complete VU1 image is
// 2048 records / 22528 words / 88 KiB.
// Sony's api_libgxm/skinning_reuse export vertex program uses this same
// writable uniform-parameter form. psp2cgc emits warning D6300 for the official
// sample as well; changing these resources to `static` is incorrect because it
// turns them into uninitialized per-instance temporary arrays.

unsigned int4 VuReadJournaledMemory(
	unsigned int address,
	unsigned int4 memoryInput[1024],
	unsigned int writeCount,
	unsigned int writeAddress[128],
	unsigned int4 writeValue[128])
{
	const unsigned int wrappedAddress = address & 0x3ffu;
	unsigned int4 value = memoryInput[wrappedAddress];
	// PCSX2's VU-memory owner requires the newest same-invocation store to
	// forward. Search only the live journal and search it backwards so the
	// first match is authoritative. The old fixed 128-iteration walk charged
	// every LQ/ILW/XGKICK read for 128 comparisons even when writeCount was
	// zero, which made memory-heavy universal programs pathologically slow.
	#pragma loop (unroll: never)
	for (unsigned int remaining = writeCount; remaining != 0u; remaining--)
	{
		const unsigned int index = remaining - 1u;
		if (writeAddress[index] == wrappedAddress)
		{
			value = writeValue[index];
			break;
		}
	}
	return value;
}

unsigned int VuPayloadU8(unsigned int payloadWords[4096],
	unsigned int byteAddress)
{
	return (payloadWords[byteAddress >> 2u] >>
		((byteAddress & 3u) * 8u)) & 0xffu;
}

unsigned int VuPayloadU16(unsigned int payloadWords[4096],
	unsigned int byteAddress)
{
	return VuPayloadU8(payloadWords, byteAddress) |
		(VuPayloadU8(payloadWords, byteAddress + 1u) << 8u);
}

unsigned int VuPayloadU32(unsigned int payloadWords[4096],
	unsigned int byteAddress)
{
	return VuPayloadU16(payloadWords, byteAddress) |
		(VuPayloadU16(payloadWords, byteAddress + 2u) << 16u);
}

unsigned int VuSignExtend8(unsigned int value, bool unsignedData)
{
	return unsignedData ? value : ((value ^ 0x80u) - 0x80u);
}

unsigned int VuSignExtend16(unsigned int value, bool unsignedData)
{
	return unsignedData ? value : ((value ^ 0x8000u) - 0x8000u);
}

void main(
	unsigned int aIndex : INDEX,
	uniform unsigned int microWords[22528] : BUFFER0,
	uniform float4 vfInput[33] : BUFFER1,
	uniform unsigned int stateInput[112] : BUFFER2,
	uniform unsigned int4 vuMemoryInput[1024] : BUFFER3,
	uniform unsigned int epochWords[512] : BUFFER4,
	uniform unsigned int vifPayloadWords[4096] : BUFFER5,
	uniform unsigned int path1Words[16384] : BUFFER6,
	uniform unsigned int armEstimateWords[640] : BUFFER7,
	uniform unsigned int path1Page1Words[16384] : BUFFER8,
	uniform unsigned int path1Page2Words[16384] : BUFFER9,
	uniform unsigned int path1Page3Words[16384] : BUFFER10,
	uniform float4 vfOutput[33] : BUFFER11,
	uniform unsigned int stateOutput[112] : BUFFER12,
	uniform unsigned int4 vuMemoryOutput[1024] : BUFFER13,
	out float4 vPosition : POSITION,
	out float vPointSize : PSIZE,
	out float4 vResult : TEXCOORD0)
{
	vPointSize = 1.0f;
	// The host may prequeue more watchdog-bounded jobs than the data-dependent
	// path ultimately needs. Stage two keeps trailing jobs on the ordinary
	// publication tail with execution disabled, preventing an early E-bit from
	// restarting the epoch before the one terminal notification.
	const unsigned int validBit = 1u << 14;
	const unsigned int executeUpperBit = 1u << 15;
	const unsigned int executeLowerBit = 1u << 16;
	const unsigned int immediateLowerBit = 1u << 17;
	const unsigned int eBit = 1u << 18;
	const unsigned int dBit = 1u << 20;
	const unsigned int tBit = 1u << 21;
	const unsigned int lowerDiscardedBit = 1u << 23;
	const unsigned int viBackupWriteBit = 1u << 31;

	unsigned int pc = stateInput[0] & 0x3fffu;
	const bool internalContinuation = stateInput[59] != 0u;
	const unsigned int submissionPairLimit = stateInput[63] != 0u ?
		stateInput[63] : 16384u;
	// A dependency job never stores through its source bindings. The complete
	// source generation is copied to a distinct output generation before sparse
	// architectural writes are applied; only that output may feed a later job.
	// A persistent dirty journal can reduce this copy after physical exactness is
	// established without reintroducing writable-uniform alias dependence.
#if VITASX2_GPU_VU_IN_PLACE_PRIVATE_GENERATION
#define VU_PUBLISH_STATE(index, value) { stateInput[(index)] = (value); }
#define VU_PUBLISH_VF(index, value) { vfInput[(index)] = (value); }
#define VU_PUBLISH_MEMORY(index, value) { vuMemoryInput[(index)] = (value); }
#else
#define VU_PUBLISH_STATE(index, value) { stateOutput[(index)] = (value); }
#define VU_PUBLISH_VF(index, value) { vfOutput[(index)] = (value); }
#define VU_PUBLISH_MEMORY(index, value) { vuMemoryOutput[(index)] = (value); }
#endif
	unsigned int pairBudget = internalContinuation ? stateInput[61] : 0u;
	unsigned int stopReason = stateInput[59] == 2u ? stateInput[2] : 0u;
	unsigned int branch = stateInput[3];
	unsigned int branchPc = stateInput[4] & 0x3fffu;
	unsigned int delayBranchPc = stateInput[5] & 0x3fffu;
	unsigned int takeDelayBranch = stateInput[6] & 1u;
	unsigned int ebitCountdown = stateInput[7];
	unsigned int executed = internalContinuation ? stateInput[27] : 0u;
	const unsigned int submissionExecutedStart = executed;
	unsigned int fbrst = internalContinuation ? stateInput[28] : 0u;
	unsigned int pendingXgkick = stateInput[33] & 1u;
	unsigned int pendingXgkickAddress = stateInput[34] & 0x3ff0u;
	unsigned int path1PacketCount = path1Words[1];
	unsigned int path1DataQwords = path1Words[2];
	unsigned int path1Error = path1Words[3];
	unsigned int macFlag = stateInput[42] & 0xffffu;
	unsigned int statusFlag = stateInput[43] & 0x0fffu;
	unsigned int clipFlag = stateInput[45] & 0x00ffffffu;
	unsigned int vuCycle = stateInput[46];
	const unsigned int configurationBits = stateInput[47];
	const bool assumeScheduled = (configurationBits & 1u) != 0u;
	const bool instantQp = (configurationBits & 2u) != 0u;
	const bool approximateQ = (configurationBits & 0x1000u) != 0u;
	const bool approximateP = (configurationBits & 0x2000u) != 0u;
	unsigned int viBackupCycles = internalContinuation ? stateInput[64] : 0u;
	unsigned int viBackupRegister = internalContinuation ? stateInput[65] : 0u;
	unsigned int viBackupOldValue = internalContinuation ? stateInput[66] : 0u;
	unsigned int qValue = stateInput[25];
	unsigned int pValue = stateInput[26];
	// PCSX2 VUops.cpp owns a four-entry FMAC dependency ring. The fixed
	// executor needs only writer identity and readiness while its admitted
	// lower subset has no architectural flag reader; working MAC/STATUS/CLIP
	// stay local and are published after the terminal drain.
