						// ignored: XYZ are produced and ACC.W/MAC.W survive.
						const float4 normalizedSource = bit_cast<float4>(
							VuNormalizeOperandBits4(bit_cast<unsigned int4>(source)));
						const float4 normalizedOperand = bit_cast<float4>(
							VuNormalizeOperandBits4(bit_cast<unsigned int4>(operand)));
						result = accumulator;
						result.x = normalizedSource.y * normalizedOperand.z;
						result.y = normalizedSource.z * normalizedOperand.x;
						result.z = normalizedSource.x * normalizedOperand.y;
						destination = 32u;
						upperWriteMask = 14u;
						updateMac = true;
						preserveMacW = true;
					}
#endif
#if VITASX2_GPU_VU_UPPER_OPMSUB
					else if (upperKind == 95u)
					{
						// PCSX2 VUops.cpp::_vuOPMSUB().  Preserve the explicit
						// multiply-then-subtract boundary via a bit round trip.
						const float4 normalizedSource = bit_cast<float4>(
							VuNormalizeOperandBits4(bit_cast<unsigned int4>(source)));
						const float4 normalizedOperand = bit_cast<float4>(
							VuNormalizeOperandBits4(bit_cast<unsigned int4>(operand)));
						const float4 normalizedAcc = bit_cast<float4>(
								VuNormalizeOperandBits4(bit_cast<unsigned int4>(accumulator)));
