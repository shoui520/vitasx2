					if (stopReason == 0u && writeUpper && destination != 0u)
					{
							float4 previous = destination == 32u ?
								accumulator : vf[destination];
							if ((upperWriteMask & 8u) != 0u) previous.x = result.x;
							if ((upperWriteMask & 4u) != 0u) previous.y = result.y;
							if ((upperWriteMask & 2u) != 0u) previous.z = result.z;
							if ((upperWriteMask & 1u) != 0u) previous.w = result.w;
							if (destination == 32u)
