			}
			else
			{
				const unsigned int cyclesBeforePair = vuCycle;
				vuCycle++;
#if VITASX2_GPU_VU_COMPACT_CONTINUATION
					if (!instantQp && lowerFdivPipe && fdivEnabled != 0u &&
						explicitWaitQ)
						vuCycle = VuMaxU(vuCycle, fdivReady);
					if (!instantQp && lowerEfuPipe && efuEnabled != 0u &&
						explicitWaitP)
					{
						if (efuReady != 0u) efuReady--;
