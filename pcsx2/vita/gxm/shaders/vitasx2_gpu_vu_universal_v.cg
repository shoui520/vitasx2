					const unsigned int upperRead0 = (upperAccess0 >> 16u) & 0xffu;
					const unsigned int upperRead0Mask = upperAccess0 >> 24u;
					const unsigned int upperRead1 = upperAccess1 & 0xffu;
					const unsigned int upperRead1Mask = (upperAccess1 >> 8u) & 0xffu;
					const unsigned int lowerRead0 = (lowerAccess0 >> 16u) & 0xffu;
					const unsigned int lowerRead0Mask = lowerAccess0 >> 24u;
					const unsigned int lowerRead1 = lowerAccess1 & 0xffu;
					const unsigned int lowerRead1Mask = (lowerAccess1 >> 8u) & 0xffu;

