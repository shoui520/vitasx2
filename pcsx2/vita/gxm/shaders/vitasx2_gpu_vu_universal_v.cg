										VuMaxBits(sourceBits.x, operandBits.x),
										VuMaxBits(sourceBits.y, operandBits.y),
										VuMaxBits(sourceBits.z, operandBits.z),
										VuMaxBits(sourceBits.w, operandBits.w));
								}
								else
								{
									resultBits = unsigned int4(
										VuMinBits(sourceBits.x, operandBits.x),
										VuMinBits(sourceBits.y, operandBits.y),
										VuMinBits(sourceBits.z, operandBits.z),
										VuMinBits(sourceBits.w, operandBits.w));
								}
