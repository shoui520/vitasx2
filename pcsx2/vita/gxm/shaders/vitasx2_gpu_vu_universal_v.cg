					#pragma branch (flatten: never)
					if (lowerKind == 1u || lowerKind == 24u || lowerKind == 25u)
					{
							// PCSX2 VUops.cpp::_vuLQ/_vuLQI/_vuLQD. Only LQ
							// has an immediate. LQI uses Is and post-increments;
							// LQD pre-decrements Is before loading. The table-3
							// opcode bits in LQI/LQD are not an address field.
							int address = (int)(short)isValue;
							if (lowerKind == 1u) address += imm11;
							// LQD decrements only when Is is nonzero. Ft is a full
							// five-bit VF index; its low four bits are merely the It
							// alias used by integer instructions.
							if (lowerKind == 25u && lis != 0u) address--;
							const float4 loaded = bit_cast<float4>(
								VuReadJournaledMemory((unsigned int)address,
									vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue));
						if (lowerVfFt != 0u)
						{
							float4 previous = vf[lowerVfFt];
							if ((lowerMask & 8u) != 0u) previous.x = loaded.x;
							if ((lowerMask & 4u) != 0u) previous.y = loaded.y;
							if ((lowerMask & 2u) != 0u) previous.z = loaded.z;
							if ((lowerMask & 1u) != 0u) previous.w = loaded.w;
							vf[lowerVfFt] = previous;
						}
						if (lowerKind == 24u && lowerVfFs != 0u)
							vi[lis] = (address + 1) & 0xffffu;
						else if (lowerKind == 25u && lis != 0u)
							vi[lis] = address & 0xffffu;
					}
#if VITASX2_GPU_VU_LOWER_SQ
					else if (
						(lowerKind == 2u || lowerKind == 26u || lowerKind == 27u))
					{
						// PCSX2 VUops.cpp::_vuSQ/_vuSQI/_vuSQD. SQ alone
						// owns the signed immediate; SQI/SQD use the unmodified
						// It address before their post/pre update respectively.
						int address = (int)(short)itValue;
						if (lowerKind == 2u) address += imm11;
						if (lowerKind == 27u && lowerVfFt != 0u) address--;
						float4 source = vf[(lower >> 11) & 31u];
							if (snapshotReg != 0u &&
							((lower >> 11) & 31u) == snapshotReg)
							source = snapshot;
							unsigned int4 stored =
								VuReadJournaledMemory((unsigned int)address,
									vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue);
						const unsigned int4 sourceBits = bit_cast<unsigned int4>(source);
						if ((lowerMask & 8u) != 0u) stored.x = sourceBits.x;
						if ((lowerMask & 4u) != 0u) stored.y = sourceBits.y;
						if ((lowerMask & 2u) != 0u) stored.z = sourceBits.z;
						if ((lowerMask & 1u) != 0u) stored.w = sourceBits.w;
							if (memoryWriteCount < 128u)
							{
								memoryWriteAddress[memoryWriteCount] =
									(unsigned int)address & 0x3ffu;
								memoryWriteValue[memoryWriteCount] = stored;
								memoryWriteCount++;
							}
							else stopReason = 12u;
						if (lowerKind == 26u && lowerVfFt != 0u)
							vi[lowerIt] = (address + 1) & 0xffffu;
						else if (lowerKind == 27u && lowerVfFt != 0u)
							vi[lowerIt] = address & 0xffffu;
					}
#endif
#if VITASX2_GPU_VU_LOWER_ILW
					else if (
						(lowerKind == 3u || lowerKind == 28u))
					{
						// PCSX2 VUops.cpp::_vuILW/_vuILWR(). VU memory is
						// addressed in qwords and wraps at the VU1 16 KiB
						// boundary. Multiple enabled lanes write VI It in
						// architectural x/y/z/w order, so the last lane wins.
							const int address = (int)(short)isValue +
								(lowerKind == 3u ? imm11 : 0);
							const unsigned int4 loaded =
								VuReadJournaledMemory((unsigned int)address,
									vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue);
						if (lowerIt != 0u)
						{
							unsigned int value = vi[lowerIt] & 0xffffu;
							if ((lowerMask & 8u) != 0u) value = loaded.x & 0xffffu;
							if ((lowerMask & 4u) != 0u) value = loaded.y & 0xffffu;
							if ((lowerMask & 2u) != 0u) value = loaded.z & 0xffffu;
							if ((lowerMask & 1u) != 0u) value = loaded.w & 0xffffu;
							vi[lowerIt] = value;
						}
					}
#endif
#if VITASX2_GPU_VU_LOWER_ISW
					else if (
						(lowerKind == 4u || lowerKind == 29u))
					{
						// PCSX2 VUops.cpp::_vuISW/_vuISWR(). Each selected
						// lane receives the zero-extended low halfword of VI It.
							const int address = (int)(short)isValue +
								(lowerKind == 4u ? imm11 : 0);
							unsigned int4 stored =
								VuReadJournaledMemory((unsigned int)address,
									vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue);
						const unsigned int value = itValue & 0xffffu;
						if ((lowerMask & 8u) != 0u) stored.x = value;
						if ((lowerMask & 4u) != 0u) stored.y = value;
						if ((lowerMask & 2u) != 0u) stored.z = value;
						if ((lowerMask & 1u) != 0u) stored.w = value;
							if (memoryWriteCount < 128u)
							{
								memoryWriteAddress[memoryWriteCount] =
									(unsigned int)address & 0x3ffu;
								memoryWriteValue[memoryWriteCount] = stored;
								memoryWriteCount++;
							}
							else stopReason = 12u;
					}
#endif
#if VITASX2_GPU_VU_LOWER_IADDI
					else if (
						(lowerKind == 5u || lowerKind == 6u || lowerKind == 21u))
					{
						if (lowerIt != 0u)
							vi[lowerIt] = (isValue +
								(lowerKind == 6u ? -imm15 :
								 lowerKind == 21u ? imm5 : imm15)) & 0xffffu;
					}
#endif
#if VITASX2_GPU_VU_LOWER_FSAND
					else if (lowerKind == 13u)
					{
						// PCSX2 VUops.cpp::_vuFSAND(). Snapshot the
						// architectural STATUS register through the exact
						// 12-bit immediate mask. This validation-only lower
						// flag reader lets Q/P edge fixtures prove D/I bits
						// without introducing a CPU observer.
						if (lowerIt != 0u)
						{
							const unsigned int flagImm =
								(((lower >> 21u) & 1u) << 11u) |
								(lower & 0x07ffu);
							vi[lowerIt] =
								(statusFlag & 0x0fffu) & flagImm;
							}
						}
#endif
#if VITASX2_GPU_VU_LOWER_IALU
					else if (
						lowerKind >= 19u && lowerKind <= 23u)
					{
						unsigned int value = 0u;
						if (lowerKind == 19u) value = isValue + itValue;
						else if (lowerKind == 20u) value = isValue - itValue;
						else if (lowerKind == 22u) value = isValue & itValue;
						else if (lowerKind == 23u) value = isValue | itValue;
						if (lid != 0u) vi[lid] = value & 0xffffu;
					}
#endif
#if VITASX2_GPU_VU_LOWER_MOVE
					else if (
						(lowerKind == 30u || lowerKind == 31u))
					{
						if (lowerVfFt != 0u)
						{
							float4 source = snapshotReg != 0u &&
								((lower >> 11) & 31u) == snapshotReg ?
								snapshot : vf[(lower >> 11) & 31u];
							if (lowerKind == 31u) source = source.yzwx;
							float4 previous = vf[lowerVfFt];
							if ((lowerMask & 8u) != 0u) previous.x = source.x;
							if ((lowerMask & 4u) != 0u) previous.y = source.y;
							if ((lowerMask & 2u) != 0u) previous.z = source.z;
							if ((lowerMask & 1u) != 0u) previous.w = source.w;
							vf[lowerVfFt] = previous;
						}
					}
#endif
#if VITASX2_GPU_VU_LOWER_MFIR
					else if (lowerKind == 32u)
					{
						// PCSX2 VUops.cpp::_vuMFIR(). The signed VI halfword is
						// copied as a raw sign-extended 32-bit value.
						if (lowerVfFt != 0u)
						{
							unsigned int scalarBits = isValue & 0xffffu;
							// psp2cgc folds the C-style unsigned->short->int cast
							// above as an unsigned halfword conversion. Spell out
							// PCSX2's signed s16 extension in raw bits so SGX and
							// the VUops.cpp::_vuMFIR oracle agree for bit 15.
							if ((scalarBits & 0x8000u) != 0u)
								scalarBits |= 0xffff0000u;
							const float scalar = bit_cast<float4>(unsigned int4(
								scalarBits, scalarBits, scalarBits, scalarBits)).x;
							float4 previous = vf[lowerVfFt];
							if ((lowerMask & 8u) != 0u) previous.x = scalar;
							if ((lowerMask & 4u) != 0u) previous.y = scalar;
							if ((lowerMask & 2u) != 0u) previous.z = scalar;
							if ((lowerMask & 1u) != 0u) previous.w = scalar;
							vf[lowerVfFt] = previous;
						}
					}
#endif
#if VITASX2_GPU_VU_LOWER_MTIR
					else if (lowerKind == 33u)
					{
						// PCSX2 VUops.cpp::_vuMTIR(). PairPlan's snapshot
						// preserves the lower source when the upper instruction
						// writes the same VF in this pair.
						if (lowerIt != 0u)
						{
							const unsigned int fsLane = (lower >> 21) & 3u;
							const float4 source = snapshotReg != 0u &&
								lowerVfFs == snapshotReg ? snapshot : vf[lowerVfFs];
							vi[lowerIt] =
								VuSelectLaneBits(bit_cast<unsigned int4>(source), fsLane) &
									0xffffu;
						}
					}
#endif
#if VITASX2_GPU_VU_LOWER_BRANCH
					else if (
						lowerKind >= 38u && lowerKind <= 47u)
					{
						bool take = false;
						const int signedIs = (int)(short)branchIsValue;
						if (lowerKind == 38u) take = branchIsValue == branchItValue;
						else if (lowerKind == 39u) take = branchIsValue != branchItValue;
						else if (lowerKind == 40u) take = signedIs < 0;
						else if (lowerKind == 41u) take = signedIs > 0;
						else if (lowerKind == 42u) take = signedIs <= 0;
						else if (lowerKind == 43u) take = signedIs >= 0;
						else if (lowerKind == 44u || lowerKind == 45u) take = true;
						else take = true;
						if (take)
						{
							const unsigned int target = lowerKind >= 46u ?
								((isValue & 0x7ffu) << 3) :
								(unsigned int)((int)pc + imm11 * 8) & 0x3fffu;
							if ((lowerKind == 45u || lowerKind == 47u) &&
								lowerIt != 0u)
							{
								vi[lowerIt] = branch == 1u ?
									((branchPc + 8u) >> 3u) : ((pc + 8u) >> 3u);
							}
							if (branch == 1u)
							{
								delayBranchPc = target;
								takeDelayBranch = 1u;
							}
							else
							{
								branch = 2u;
								branchPc = target;
							}
							}
						}
#endif
#if VITASX2_GPU_VU_LOWER_MFP
						else if (lowerKind == 48u)
						{
							// PCSX2 VUops.cpp::_vuMFP(). P is a raw scalar bit
							// pattern copied into every selected VF lane.
							if (lowerVfFt != 0u)
							{
								const float pScalar = bit_cast<float4>(
									unsigned int4(pValue, pValue, pValue, pValue)).x;
								float4 previous = vf[lowerVfFt];
								if ((lowerMask & 8u) != 0u) previous.x = pScalar;
								if ((lowerMask & 4u) != 0u) previous.y = pScalar;
								if ((lowerMask & 2u) != 0u) previous.z = pScalar;
								if ((lowerMask & 1u) != 0u) previous.w = pScalar;
								vf[lowerVfFt] = previous;
							}
						}
#endif
#if VITASX2_GPU_VU_LOWER_WAIT
						else if (
							(lowerKind == 49u || lowerKind == 50u))
						{
							// PCSX2 VUops.cpp::_vuWAITQ/_vuWAITP(). The visible
							// work is the pipeline flush already performed before
							// this lower body executes.
						}
#endif
#if VITASX2_GPU_VU_LOWER_XITOP
						else if (lowerKind == 51u)
						{
							// PCSX2 VUops.cpp::_vuXITOP(). ITOP is retained by the
							// command epoch and published in state word 41.
							if (lowerIt != 0u)
								vi[lowerIt] = vifItop;
						}
#endif
#if VITASX2_GPU_VU_LOWER_XTOP
						else if (lowerKind == 52u)
						{
							// PCSX2 VUops.cpp::_vuXTOP().  TOP is retained by every
							// serialized UNPACK/Execute descriptor and published in
							// state word 40 before VU execution starts.
							if (lowerIt != 0u)
								vi[lowerIt] = vifTop;
						}
#endif
#if VITASX2_GPU_VU_LOWER_FDIV
						else if (lowerKind == 53u)
						{
							// PCSX2 VUops.cpp::_vuDIV().  This validation tier
							// covers finite hardware-aligned values and the exact
							// zero-divisor STATUS/Q edge.
							const unsigned int fsLane = (lower >> 21) & 3u;
							const unsigned int ftLane = (lower >> 23) & 3u;
							const unsigned int4 fsVector =
								bit_cast<unsigned int4>(vf[lowerVfFs]);
							const unsigned int4 ftVector =
								bit_cast<unsigned int4>(vf[lowerVfFt]);
							const unsigned int fsBits =
								VuNormalizeOperandBits(VuSelectLaneBits(fsVector, fsLane));
							const unsigned int ftBits =
								VuNormalizeOperandBits(VuSelectLaneBits(ftVector, ftLane));
							unsigned int nextStatus = statusFlag & ~0x30u;
							unsigned int nextQ = 0u;
							if ((ftBits & 0x7fffffffu) == 0u)
							{
								nextStatus |= (fsBits & 0x7fffffffu) == 0u ?
									0x10u : 0x20u;
								nextQ = ((fsBits ^ ftBits) & 0x80000000u) != 0u ?
									0xff7fffffu : 0x7f7fffffu;
							}
							else
							{
								nextQ = VuBitsFromFloat(
									VuFloatFromBits(fsBits) / VuFloatFromBits(ftBits));
							}
							if (instantQp)
							{
								qValue = nextQ;
								statusFlag = VuMergeFdivStatus(statusFlag, nextStatus);
							}
							else
							{
								fdivReady = vuCycle + (unsigned int)lowerLatency;
								fdivValue = nextQ;
								fdivStatus = nextStatus;
								fdivEnabled = 1u;
							}
						}
						else if (lowerKind == 54u)
						{
							// PCSX2 VUops.cpp::_vuSQRT().  Negative finite input
							// sets the current I bit and square-roots the absolute
							// value; the validation fixture uses exact finite roots.
							const unsigned int ftLane = (lower >> 23) & 3u;
							const unsigned int4 ftVector =
								bit_cast<unsigned int4>(vf[lowerVfFt]);
							const unsigned int ftBits =
								VuNormalizeOperandBits(
									VuSelectLaneBits(ftVector, ftLane));
							unsigned int nextStatus = statusFlag & ~0x30u;
							if ((ftBits & 0x80000000u) != 0u &&
								VuAbsBits(ftBits) != 0u)
							{
								nextStatus |= 0x10u;
							}
							const unsigned int nextQ = VuBitsFromFloat(
								sqrt(VuFloatFromBits(VuAbsBits(ftBits))));
							if (instantQp)
							{
								qValue = nextQ;
								statusFlag = VuMergeFdivStatus(statusFlag, nextStatus);
							}
							else
							{
								fdivReady = vuCycle + (unsigned int)lowerLatency;
								fdivValue = nextQ;
								fdivStatus = nextStatus;
								fdivEnabled = 1u;
							}
						}
						else if (lowerKind == 55u)
						{
							// PCSX2 VUops.cpp::_vuRSQRT().  This keeps the
							// zero-divisor and negative-radicand D/I status edges
							// while the v11 physical fixture checks a finite exact
							// result through a following MULq consumer.
							const unsigned int fsLane = (lower >> 21) & 3u;
							const unsigned int ftLane = (lower >> 23) & 3u;
							const unsigned int4 fsVector =
								bit_cast<unsigned int4>(vf[lowerVfFs]);
							const unsigned int4 ftVector =
								bit_cast<unsigned int4>(vf[lowerVfFt]);
							const unsigned int fsBits =
								VuNormalizeOperandBits(
									VuSelectLaneBits(fsVector, fsLane));
							const unsigned int ftBits =
								VuNormalizeOperandBits(
									VuSelectLaneBits(ftVector, ftLane));
							const unsigned int fsAbs = VuAbsBits(fsBits);
							const unsigned int ftAbs = VuAbsBits(ftBits);
							unsigned int nextStatus = statusFlag & ~0x30u;
							unsigned int nextQ;
							if (ftAbs == 0u)
							{
								nextStatus |= 0x20u;
								const bool negative =
									((fsBits ^ ftBits) & 0x80000000u) != 0u;
								if (fsAbs != 0u)
								{
									nextQ = negative ? 0xff7fffffu : 0x7f7fffffu;
								}
								else
								{
									nextQ = negative ? 0x80000000u : 0u;
									nextStatus |= 0x10u;
								}
							}
							else
							{
								if ((ftBits & 0x80000000u) != 0u)
									nextStatus |= 0x10u;
								const float root =
									sqrt(VuFloatFromBits(ftAbs));
								nextQ = VuBitsFromFloat(
									VuFloatFromBits(fsBits) / root);
							}
							if (instantQp)
							{
								qValue = nextQ;
								statusFlag = VuMergeFdivStatus(statusFlag, nextStatus);
							}
							else
							{
								fdivReady = vuCycle + (unsigned int)lowerLatency;
								fdivValue = nextQ;
								fdivStatus = nextStatus;
									fdivEnabled = 1u;
								}
							}
#endif
#if VITASX2_GPU_VU_LOWER_XGKICK
						else if (lowerKind == 56u)
						{
							pendingXgkickAddress = (isValue & 0x3ffu) << 4;
							pendingXgkick = 1u;
						}
#endif
#if VITASX2_GPU_VU_LOWER_ESADD
						else if (lowerKind == 57u)
						{
							// PCSX2 VUops.cpp::_vuESADD().
							const unsigned int4 sourceBits =
								bit_cast<unsigned int4>(vf[lowerVfFs]);
							const unsigned int nextP =
								VuEfuSumXyzSquaresBits(sourceBits);
							if (instantQp)
							{
								pValue = nextP;
							}
							else
							{
								efuReady = vuCycle + (unsigned int)lowerLatency;
								efuValue = nextP;
									efuEnabled = 1u;
								}
							}
#endif
#if VITASX2_GPU_VU_LOWER_ERSADD
						else if (lowerKind == 58u)
						{
							// PCSX2 VUops.cpp::_vuERSADD() under the product's
							// Cortex-A9 approximate-P contract.
							const unsigned int4 sourceBits =
								bit_cast<unsigned int4>(vf[lowerVfFs]);
							const unsigned int sumBits =
								VuEfuSumXyzSquaresBits(sourceBits);
							unsigned int nextP = sumBits;
							if ((sumBits & 0x7fffffffu) != 0u)
							{
								const unsigned int estimateIndex =
									(sumBits >> 15u) & 0xffu;
								const unsigned int estimateField =
									armEstimateWords[estimateIndex];
								const unsigned int exponent =
									(sumBits >> 23u) & 0xffu;
								const unsigned int seedBits =
									((253u - exponent) << 23u) |
									(estimateField << 15u);
								const float diagnosticValue =
									VuRawFloatFromBits(sumBits);
								const float diagnosticSeed =
									VuRawFloatFromBits(seedBits);
								const unsigned int productBits = VuRawBitsFromFloat(
									diagnosticValue * diagnosticSeed);
								const unsigned int stepBits = VuRawBitsFromFloat(
									2.0f - VuRawFloatFromBits(productBits));
								nextP = VuArmApproximateReciprocalBits(
									sumBits, estimateField);
								// Words 48..58 are outside the architectural state ABI and
								// belong only to this one-shot physical semantic owner.
								VU_PUBLISH_STATE(48u, lowerVfFs);
								VU_PUBLISH_STATE(49u, sourceBits.x);
								VU_PUBLISH_STATE(50u, sourceBits.y);
								VU_PUBLISH_STATE(51u, sourceBits.z);
								VU_PUBLISH_STATE(52u, sumBits);
								VU_PUBLISH_STATE(53u, estimateIndex);
								VU_PUBLISH_STATE(54u, estimateField);
								VU_PUBLISH_STATE(55u, seedBits);
								VU_PUBLISH_STATE(56u, productBits);
								VU_PUBLISH_STATE(57u, stepBits);
								VU_PUBLISH_STATE(58u, nextP);
							}
							if (instantQp)
								pValue = nextP;
							else
							{
								efuReady = vuCycle + (unsigned int)lowerLatency;
								efuValue = nextP;
								efuEnabled = 1u;
							}
						}
#endif
#if VITASX2_GPU_VU_LOWER_ESQRT
						else if (lowerKind == 65u)
						{
							// PCSX2 VUops.cpp::_vuESQRT() under the same immutable
							// approximate-P configuration identity.
							const unsigned int fsLane = (lower >> 21u) & 3u;
							const unsigned int inputBits = VuNormalizeOperandBits(
								VuSelectLaneBits(
									bit_cast<unsigned int4>(vf[lowerVfFs]), fsLane));
							unsigned int nextP = inputBits;
							if ((inputBits & 0x80000000u) == 0u)
							{
								if ((inputBits & 0x7fffffffu) != 0u &&
									(inputBits & 0x7f800000u) != 0x7f800000u)
								{
									const unsigned int exponent =
										(inputBits >> 23u) & 0xffu;
									const unsigned int scaled = (exponent & 1u) != 0u ?
										(0x80u | ((inputBits >> 16u) & 0x7fu)) :
										(0x100u | ((inputBits >> 15u) & 0xffu));
									nextP = VuArmApproximateSqrtBits(inputBits,
										armEstimateWords[256u + scaled - 128u]);
								}
							}
							if (instantQp)
								pValue = nextP;
							else
							{
								efuReady = vuCycle + (unsigned int)lowerLatency;
								efuValue = nextP;
								efuEnabled = 1u;
							}
						}
#endif
						else
						{
							stopReason = 6u;
					}
				}

				const bool addsFmac = upperPipe == 1u || lowerPipe == 1u;
				if (addsFmac && stopReason == 0u)
				{
					const unsigned int upperWriter = upperPipe == 1u ?
						(upperAccess0 & 0xffffu) : 0u;
					const unsigned int lowerWriter = lowerPipe == 1u ?
						(lowerAccess0 & 0xffffu) : 0u;
					if (fmacCount == 0u)
					{
						fmacReady.x = vuCycle + 4u;
						fmacUpperWriter.x = upperWriter;
						fmacLowerWriter.x = lowerWriter;
					}
					else if (fmacCount == 1u)
					{
						fmacReady.y = vuCycle + 4u;
						fmacUpperWriter.y = upperWriter;
						fmacLowerWriter.y = lowerWriter;
					}
					else if (fmacCount == 2u)
					{
						fmacReady.z = vuCycle + 4u;
						fmacUpperWriter.z = upperWriter;
						fmacLowerWriter.z = lowerWriter;
					}
					else if (fmacCount == 3u)
					{
						fmacReady.w = vuCycle + 4u;
						fmacUpperWriter.w = upperWriter;
						fmacLowerWriter.w = lowerWriter;
					}
					else stopReason = 12u;
					if (stopReason == 0u) fmacCount++;
				}
#if VITASX2_GPU_VU_COMPACT_CONTINUATION
				// PairPlan scheduling has already made every IALU consumer legal.
#else
				if (!assumeScheduled && lowerPipe == 4u && lowerLatency > 0 &&
					stopReason == 0u)
				{
					const unsigned int ready = vuCycle + (unsigned int)lowerLatency;
					const unsigned int writerMask = microWords[wordIndex + 6u];
					if (ialuCount == 0u)
					{
						ialuReady.x = ready;
						ialuWriterMask.x = writerMask;
					}
					else if (ialuCount == 1u)
					{
						ialuReady.y = ready;
						ialuWriterMask.y = writerMask;
					}
					else if (ialuCount == 2u)
					{
						ialuReady.z = ready;
						ialuWriterMask.z = writerMask;
					}
					else if (ialuCount == 3u)
					{
						ialuReady.w = ready;
						ialuWriterMask.w = writerMask;
					}
					else stopReason = 12u;
					if (stopReason == 0u) ialuCount++;
				}
#endif

				// PCSX2 normal microVU publishes the packet after the complete pair
				// following XGKICK. Scan every tag before the first output write, then
				// append one EOP-bounded raw packet. BUFFER6 owns the descriptor
					// page and data tail; BUFFER8..10 extend that tail into one mapped
				// transactional generation. Exhaustion fails closed and never
				// publishes a prefix.
				#pragma branch (flatten: never)
				if (exportPath1 && stopReason == 0u)
				{
					unsigned int packetQwords = 0u;
					unsigned int packetTags = 0u;
					bool packetEop = false;
					bool packetValid = true;
					#pragma loop (unroll: never)
					for (unsigned int tagStep = 0u; tagStep < 1024u; tagStep++)
					{
						if (!packetEop && packetValid)
						{
							const unsigned int tagQword =
								((exportPath1Address >> 4) + packetQwords) & 0x3ffu;
								const unsigned int4 tag = VuReadJournaledMemory(
									tagQword, vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue);
							const unsigned int nloop = tag.x & 0x7fffu;
							unsigned int nreg = (tag.y >> 28) & 15u;
							if (nreg == 0u) nreg = 16u;
							const unsigned int flg = (tag.y >> 26) & 3u;
							unsigned int payloadQwords = nloop;
							if (flg == 0u) payloadQwords = nloop * nreg;
							else if (flg == 1u)
								payloadQwords = (nloop * nreg + 1u) >> 1;
							const unsigned int nextQwords =
								packetQwords + 1u + payloadQwords;
							if (nextQwords >= 1024u)
							{
								packetValid = false;
							}
							else
							{
								packetQwords = nextQwords;
								packetTags++;
								packetEop = (tag.x & 0x8000u) != 0u;
							}
						}
					}
					if (!packetValid || !packetEop)
					{
						// PCSX2 owner: VUops.cpp::_vuXGKICKTransferMicroVU().
						// GetGSPacketSize() returning zero cancels this XGKICK in
						// PCSX2. The universal product cannot yet prove that a
						// malformed GPU packet matches canonical VU memory, so keep
						// the generation private and retain bounded diagnostics for
						// the CPU replay comparison.
							const unsigned int4 rejectedTag =
								VuReadJournaledMemory(exportPath1Address >> 4,
									vuMemoryInput, memoryWriteCount,
									memoryWriteAddress, memoryWriteValue);
						path1Words[4] = path1Words[4] + 1u;
						path1Words[5] = exportPath1Address;
						path1Words[6] = rejectedTag.x;
						path1Words[7] = rejectedTag.y;
						path1Words[8] = rejectedTag.z;
						path1Words[9] = rejectedTag.w;
						path1Words[10] = packetQwords;
						path1Words[11] = packetTags;
						stopReason = 9u;
						path1Error = 3u;
					}
					else if (path1PacketCount >= 256u)
					{
						stopReason = 9u;
						path1Error = 5u;
					}
						else if (packetQwords > 16120u - path1DataQwords)
					{
						stopReason = 9u;
						path1Error = 4u;
					}
					else
					{
						#pragma loop (unroll: never)
						for (unsigned int copyQword = 0u;
							copyQword < 1024u; copyQword++)
						{
							if (copyQword < packetQwords)
							{
									const unsigned int4 source =
										VuReadJournaledMemory(
											(exportPath1Address >> 4) + copyQword,
											vuMemoryInput, memoryWriteCount,
											memoryWriteAddress, memoryWriteValue);
								const unsigned int outputQword =
									path1DataQwords + copyQword;
								if (outputQword < 3832u)
								{
									const unsigned int outputWord =
										1056u + outputQword * 4u;
									path1Words[outputWord + 0u] = source.x;
									path1Words[outputWord + 1u] = source.y;
									path1Words[outputWord + 2u] = source.z;
									path1Words[outputWord + 3u] = source.w;
								}
								else
								{
									const unsigned int pagedQword =
										outputQword - 3832u;
									const unsigned int page = pagedQword >> 12u;
									const unsigned int outputWord =
										(pagedQword & 4095u) * 4u;
									if (page == 0u)
									{
										path1Page1Words[outputWord + 0u] = source.x;
										path1Page1Words[outputWord + 1u] = source.y;
										path1Page1Words[outputWord + 2u] = source.z;
										path1Page1Words[outputWord + 3u] = source.w;
									}
									else if (page == 1u)
									{
										path1Page2Words[outputWord + 0u] = source.x;
										path1Page2Words[outputWord + 1u] = source.y;
										path1Page2Words[outputWord + 2u] = source.z;
										path1Page2Words[outputWord + 3u] = source.w;
									}
									else if (page == 2u)
									{
										path1Page3Words[outputWord + 0u] = source.x;
										path1Page3Words[outputWord + 1u] = source.y;
										path1Page3Words[outputWord + 2u] = source.z;
										path1Page3Words[outputWord + 3u] = source.w;
									}
								}
							}
						}
						const unsigned int descriptor =
							16u + path1PacketCount * 4u;
						path1Words[descriptor + 0u] = exportPath1Address;
						path1Words[descriptor + 1u] = path1DataQwords;
						path1Words[descriptor + 2u] = packetQwords;
						path1Words[descriptor + 3u] = packetTags;
						path1PacketCount++;
						path1DataQwords += packetQwords;
					}
				}

				if (branch > 0u)
				{
					if (branch == 1u)
					{
						pc = branchPc;
						if (takeDelayBranch != 0u)
						{
							branch = 1u;
							branchPc = delayBranchPc;
							takeDelayBranch = 0u;
						}
						else branch = 0u;
					}
					else branch--;
				}
				if (ebitCountdown > 0u)
				{
					if (ebitCountdown == 1u)
					{
						ebitCountdown = 0u;
						stopReason = 1u;
					}
					else ebitCountdown--;
				}
				executed++;
				pairBudget--;
			}
		}
	}
	if (stopReason == 0u && stateInput[38] != 0u &&
		pc == stateInput[37] && branch == 0u && ebitCountdown == 0u)
		stopReason = 13u;
	else if (stopReason == 0u && pairBudget == 0u)
		stopReason = 7u;
	else if (stopReason == 0u &&
		executed - submissionExecutedStart >= submissionPairLimit)
		stopReason = 13u;
	// A packet queued by the terminal E-bit delay slot is flushed by the narrow
	// fixed PATH1 commit kernel. Stop this core after draining every VU pipeline
	// and publish phase 3; the dependency job appends the packet before either
	// command parsing resumes or the terminal End generation is committed.
	if (stopReason == 1u && pendingXgkick != 0u)
		stopReason = 10u;
	if (stopReason == 1u || stopReason == 10u)
		{
			// PCSX2 VU1microInterp.cpp::_vu1FinishProgram() drains every pending
			// dependency pipe and clears the branch-visibility compatibility window.
			if (fdivEnabled != 0u)
			{
				vuCycle = VuMaxU(vuCycle, fdivReady);
				qValue = fdivValue;
				statusFlag = VuMergeFdivStatus(statusFlag, fdivStatus);
			}
			if (efuEnabled != 0u)
			{
				vuCycle = VuMaxU(vuCycle, efuReady);
				pValue = efuValue;
			}
			if (fmacCount > 0u) vuCycle = VuMaxU(vuCycle, fmacReady.x);
			if (fmacCount > 1u) vuCycle = VuMaxU(vuCycle, fmacReady.y);
			if (fmacCount > 2u) vuCycle = VuMaxU(vuCycle, fmacReady.z);
		if (fmacCount > 3u) vuCycle = VuMaxU(vuCycle, fmacReady.w);
		if (ialuCount > 0u) vuCycle = VuMaxU(vuCycle, ialuReady.x);
		if (ialuCount > 1u) vuCycle = VuMaxU(vuCycle, ialuReady.y);
			if (ialuCount > 2u) vuCycle = VuMaxU(vuCycle, ialuReady.z);
			if (ialuCount > 3u) vuCycle = VuMaxU(vuCycle, ialuReady.w);
			fmacCount = 0u;
			ialuCount = 0u;
			fdivEnabled = 0u;
			efuEnabled = 0u;
			viBackupCycles = 0u;
		}
#if VITASX2_GPU_VU_COMPACT_CONTINUATION
			if (stopReason == 1u)
				epochEnded = true;
#else
			if (stopReason == 1u && !epochEnded)
				stopReason = 0u;
#endif
		}
		}
	}
	if (!epochEnded && stopReason == 0u)
		stopReason = 8u;

	VU_PUBLISH_STATE(0u, pc);
	VU_PUBLISH_STATE(2u, stopReason == 0u ? 7u : stopReason);
	VU_PUBLISH_STATE(3u, branch);
	VU_PUBLISH_STATE(4u, branchPc);
	VU_PUBLISH_STATE(5u, delayBranchPc);
	VU_PUBLISH_STATE(6u, takeDelayBranch);
	VU_PUBLISH_STATE(7u, ebitCountdown);
	VU_PUBLISH_STATE(27u, executed);
	#pragma loop (unroll: never)
	for (unsigned int publishVi = 1u; publishVi < 16u; publishVi++)
		VU_PUBLISH_STATE(8u + publishVi, vi[publishVi] & 0xffffu);
	VU_PUBLISH_STATE(24u, iValue);
	VU_PUBLISH_STATE(31u, commandCount);
	VU_PUBLISH_STATE(32u, unpackVectorCount);
	VU_PUBLISH_STATE(40u, vifTop);
	VU_PUBLISH_STATE(41u, vifItop);
	VU_PUBLISH_STATE(33u, pendingXgkick);
	VU_PUBLISH_STATE(34u, pendingXgkickAddress);
	VU_PUBLISH_STATE(25u, qValue);
	VU_PUBLISH_STATE(26u, pValue);
	VU_PUBLISH_STATE(42u, macFlag);
	VU_PUBLISH_STATE(43u, statusFlag);
	VU_PUBLISH_STATE(45u, clipFlag);
	VU_PUBLISH_STATE(46u, vuCycle);
	VU_PUBLISH_STATE(47u, configurationBits);
	const bool publishContinuation = stopReason == 13u;
	const bool publishPath1Commit = stopReason == 10u;
	VU_PUBLISH_STATE(59u, publishPath1Commit ? 3u :
		(publishContinuation ? 1u :
		(stopReason != 0u ? 2u : 0u)));
	VU_PUBLISH_STATE(60u,
		publishContinuation || publishPath1Commit ? commandCursor : 0u);
	VU_PUBLISH_STATE(61u, publishContinuation ? pairBudget : 0u);
	VU_PUBLISH_STATE(62u, publishContinuation && sawExecute ? 1u : 0u);
	// The full fixed core owns the first command/UNPACK transition with its
	// conservative slice, then publishes the separately attested compact limit
	// from word 36 for dependency-ordered continuation jobs. Validation leaves
	// word 36 zero and retains its original one-shot limit.
#if VITASX2_GPU_VU_COMPACT_CONTINUATION
	VU_PUBLISH_STATE(63u, submissionPairLimit);
#else
	VU_PUBLISH_STATE(63u,
		publishContinuation && sawExecute && stateInput[36] != 0u ?
			stateInput[36] : submissionPairLimit);
#endif
	VU_PUBLISH_STATE(64u, publishContinuation ? viBackupCycles : 0u);
	VU_PUBLISH_STATE(65u, publishContinuation ? viBackupRegister : 0u);
	VU_PUBLISH_STATE(66u, publishContinuation ? viBackupOldValue : 0u);
	VU_PUBLISH_STATE(67u, publishContinuation ? fmacCount : 0u);
	VU_PUBLISH_STATE(68u, publishContinuation ? fmacReady.x : 0u);
	VU_PUBLISH_STATE(69u, publishContinuation ? fmacReady.y : 0u);
	VU_PUBLISH_STATE(70u, publishContinuation ? fmacReady.z : 0u);
	VU_PUBLISH_STATE(71u, publishContinuation ? fmacReady.w : 0u);
	VU_PUBLISH_STATE(72u, publishContinuation ? fmacUpperWriter.x : 0u);
	VU_PUBLISH_STATE(73u, publishContinuation ? fmacUpperWriter.y : 0u);
	VU_PUBLISH_STATE(74u, publishContinuation ? fmacUpperWriter.z : 0u);
	VU_PUBLISH_STATE(75u, publishContinuation ? fmacUpperWriter.w : 0u);
	VU_PUBLISH_STATE(76u, publishContinuation ? fmacLowerWriter.x : 0u);
	VU_PUBLISH_STATE(77u, publishContinuation ? fmacLowerWriter.y : 0u);
	VU_PUBLISH_STATE(78u, publishContinuation ? fmacLowerWriter.z : 0u);
	VU_PUBLISH_STATE(79u, publishContinuation ? fmacLowerWriter.w : 0u);
	VU_PUBLISH_STATE(80u, publishContinuation ? ialuCount : 0u);
	VU_PUBLISH_STATE(81u, publishContinuation ? ialuReady.x : 0u);
	VU_PUBLISH_STATE(82u, publishContinuation ? ialuReady.y : 0u);
	VU_PUBLISH_STATE(83u, publishContinuation ? ialuReady.z : 0u);
	VU_PUBLISH_STATE(84u, publishContinuation ? ialuReady.w : 0u);
	VU_PUBLISH_STATE(85u, publishContinuation ? ialuWriterMask.x : 0u);
	VU_PUBLISH_STATE(86u, publishContinuation ? ialuWriterMask.y : 0u);
	VU_PUBLISH_STATE(87u, publishContinuation ? ialuWriterMask.z : 0u);
	VU_PUBLISH_STATE(88u, publishContinuation ? ialuWriterMask.w : 0u);
	VU_PUBLISH_STATE(89u, publishContinuation ? fdivReady : 0u);
	VU_PUBLISH_STATE(90u, publishContinuation ? fdivValue : 0u);
	VU_PUBLISH_STATE(91u, publishContinuation ? fdivStatus : 0u);
	VU_PUBLISH_STATE(92u, publishContinuation ? fdivEnabled : 0u);
	VU_PUBLISH_STATE(93u, publishContinuation ? efuReady : 0u);
	VU_PUBLISH_STATE(94u, publishContinuation ? efuValue : 0u);
	VU_PUBLISH_STATE(95u, publishContinuation ? efuEnabled : 0u);
#if VITASX2_GPU_VU_INLINE_UNPACK
	VU_PUBLISH_STATE(96u, vifRow.x);
	VU_PUBLISH_STATE(97u, vifRow.y);
	VU_PUBLISH_STATE(98u, vifRow.z);
	VU_PUBLISH_STATE(99u, vifRow.w);
	VU_PUBLISH_STATE(100u, vifColumn.x);
	VU_PUBLISH_STATE(101u, vifColumn.y);
	VU_PUBLISH_STATE(102u, vifColumn.z);
	VU_PUBLISH_STATE(103u, vifColumn.w);
	VU_PUBLISH_STATE(104u, publishContinuation ? unpackVectorCursor : 0u);
	VU_PUBLISH_STATE(105u, publishContinuation ? unpackSourceCursor : 0u);
	VU_PUBLISH_STATE(106u, publishContinuation ? unpackDestinationCursor : 0u);
	VU_PUBLISH_STATE(107u, publishContinuation ? unpackCycleCursor : 0u);
	VU_PUBLISH_STATE(108u, publishContinuation ? unpackGeneratedCursor : 0u);
	VU_PUBLISH_STATE(109u, publishContinuation ? unpackCommandMarker : 0u);
	VU_PUBLISH_STATE(110u, 0u);
	VU_PUBLISH_STATE(111u, 0u);
#endif
	vf[32] = accumulator;
	#pragma loop (unroll: never)
	for (unsigned int publishVf = 0u; publishVf < 33u; publishVf++)
		VU_PUBLISH_VF(publishVf, vf[publishVf]);
	#pragma loop (unroll: never)
	for (unsigned int publishMemory = 0u;
		publishMemory < memoryWriteCount; publishMemory++)
	{
		VU_PUBLISH_MEMORY(memoryWriteAddress[publishMemory],
			memoryWriteValue[publishMemory]);
	}
	path1Words[0] = 1u;
	path1Words[1] = path1PacketCount;
	path1Words[2] = path1DataQwords;
	path1Words[3] = path1Error;

	// One invocation executes one dependent chain. Rendering is deliberately a
	// dummy point; complete raw PATH1 output remains in BUFFER6 for one coarse
	// command-epoch consumer rather than forcing a wait at each XGKICK.
	vPosition = float4(2.0f, 2.0f, 2.0f, 1.0f);
	vResult = float4((float)executed,
		(float)(stopReason == 0u ? 7u : stopReason),
		(float)(pc >> 3), (float)aIndex);
#undef VU_PUBLISH_MEMORY
#undef VU_PUBLISH_VF
#undef VU_PUBLISH_STATE
}
