					float4 operand = vf[ft];
					float4 result = vf[fd];
					unsigned int destination = fd;
					unsigned int upperWriteMask = writeMask;
					bool writeUpper = true;
					bool updateMac = false;
					bool preserveMacW = false;
					#pragma branch (flatten: never)
