						if (upperKind >= 11u && upperKind <= 17u)
							familyBase = 11u; // ADD
						else if (upperKind >= 18u && upperKind <= 24u)
							familyBase = 18u; // ADDA
						else if (upperKind >= 25u && upperKind <= 31u)
							familyBase = 25u; // SUB
						else if (upperKind >= 32u && upperKind <= 38u)
							familyBase = 32u; // SUBA
						else if (upperKind >= 39u && upperKind <= 44u)
							familyBase = 39u; // MAX
						else if (upperKind >= 45u && upperKind <= 50u)
							familyBase = 45u; // MINI
						else if (upperKind >= 52u && upperKind <= 58u)
							familyBase = 52u; // MUL
						else if (upperKind >= 59u && upperKind <= 65u)
							familyBase = 59u; // MULA
						else if (upperKind >= 66u && upperKind <= 72u)
							familyBase = 66u; // MADD
						else if (upperKind >= 73u && upperKind <= 79u)
							familyBase = 73u; // MADDA
						else if (upperKind >= 80u && upperKind <= 86u)
							familyBase = 80u; // MSUB
						else if (upperKind >= 87u && upperKind <= 93u)
							familyBase = 87u; // MSUBA

