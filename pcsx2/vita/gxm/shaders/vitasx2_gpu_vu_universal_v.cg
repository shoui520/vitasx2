							resultBits.x = VuMacUpdate(resultBits.x, 3u, macFlag);
						else VuClearMacLane(3u, macFlag);
						if ((upperWriteMask & 4u) != 0u)
							resultBits.y = VuMacUpdate(resultBits.y, 2u, macFlag);
						else VuClearMacLane(2u, macFlag);
						if ((upperWriteMask & 2u) != 0u)
							resultBits.z = VuMacUpdate(resultBits.z, 1u, macFlag);
						else VuClearMacLane(1u, macFlag);
						if ((upperWriteMask & 1u) != 0u)
							resultBits.w = VuMacUpdate(resultBits.w, 0u, macFlag);
						else if (!preserveMacW) VuClearMacLane(0u, macFlag);
