				const unsigned int fs = (upper >> 11) & 31u;
				const unsigned int fd = (upper >> 6) & 31u;
				const unsigned int writeMask = (upper >> 21) & 15u;
				const unsigned int snapshotReg = (control >> 24) & 31u;
				const float4 snapshot = vf[snapshotReg];
