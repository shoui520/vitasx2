						// lanes are signed fixed-point integers held in VF bit
						// patterns. Construct their exact round-to-nearest-even
						// IEEE-754 bits before applying the encoded power-of-two
						// scale in the exponent field.
						const unsigned int4 sourceBits =
							bit_cast<unsigned int4>(source);
						unsigned int scaleShift = 0u;
						if (upperKind == 8u) scaleShift = 4u;
						else if (upperKind == 9u) scaleShift = 12u;
						else if (upperKind == 10u) scaleShift = 15u;
						const unsigned int4 resultBits = unsigned int4(
							VuSignedIntToFloatBits(sourceBits.x, scaleShift),
							VuSignedIntToFloatBits(sourceBits.y, scaleShift),
							VuSignedIntToFloatBits(sourceBits.z, scaleShift),
							VuSignedIntToFloatBits(sourceBits.w, scaleShift));
