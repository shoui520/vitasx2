					if (upperPipe == 1u)
					{
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.x,
								fmacLowerWriter.x, fmacReady.x, upperRead0,
								upperRead0Mask, upperRead1, upperRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.y,
								fmacLowerWriter.y, fmacReady.y, upperRead0,
								upperRead0Mask, upperRead1, upperRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.z,
								fmacLowerWriter.z, fmacReady.z, upperRead0,
								upperRead0Mask, upperRead1, upperRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.w,
								fmacLowerWriter.w, fmacReady.w, upperRead0,
								upperRead0Mask, upperRead1, upperRead1Mask));
					}
					if (lowerPipe == 1u || lowerQpPipe)
					{
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.x,
								fmacLowerWriter.x, fmacReady.x, lowerRead0,
								lowerRead0Mask, lowerRead1, lowerRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.y,
								fmacLowerWriter.y, fmacReady.y, lowerRead0,
								lowerRead0Mask, lowerRead1, lowerRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.z,
								fmacLowerWriter.z, fmacReady.z, lowerRead0,
								lowerRead0Mask, lowerRead1, lowerRead1Mask));
						dependencyCycle = VuMaxU(dependencyCycle,
							VuFmacDependencyReady(fmacUpperWriter.w,
								fmacLowerWriter.w, fmacReady.w, lowerRead0,
								lowerRead0Mask, lowerRead1, lowerRead1Mask));
					}
					if (lowerPipe == 5u)
					{
						if ((ialuWriterMask.x & lowerViRead) != 0u)
							dependencyCycle = VuMaxU(dependencyCycle, ialuReady.x);
						if ((ialuWriterMask.y & lowerViRead) != 0u)
							dependencyCycle = VuMaxU(dependencyCycle, ialuReady.y);
						if ((ialuWriterMask.z & lowerViRead) != 0u)
							dependencyCycle = VuMaxU(dependencyCycle, ialuReady.z);
						if ((ialuWriterMask.w & lowerViRead) != 0u)
							dependencyCycle = VuMaxU(dependencyCycle, ialuReady.w);
						}
						vuCycle = VuMaxU(vuCycle, dependencyCycle);
					}
					if (!instantQp && lowerFdivPipe && fdivEnabled != 0u &&
						(!assumeScheduled || explicitWaitQ))
