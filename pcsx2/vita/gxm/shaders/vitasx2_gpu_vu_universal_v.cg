							else
							{
								const float4 normalizedSource = bit_cast<float4>(
									VuNormalizeOperandBits4(
										bit_cast<unsigned int4>(source)));
								const float4 normalizedOperand = bit_cast<float4>(
									VuNormalizeOperandBits4(
										bit_cast<unsigned int4>(operand)));
								const bool writesAccumulator = familyBase == 18u ||
