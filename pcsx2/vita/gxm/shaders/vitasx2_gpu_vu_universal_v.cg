							VuFloatToSignedIntBits(sourceBits.x, scaleShift),
							VuFloatToSignedIntBits(sourceBits.y, scaleShift),
							VuFloatToSignedIntBits(sourceBits.z, scaleShift),
							VuFloatToSignedIntBits(sourceBits.w, scaleShift));
						result = bit_cast<float4>(resultBits);
						destination = ft;
					}
#endif
#if VITASX2_GPU_VU_UPPER_ITOF
					else if (
						upperKind >= 7u && upperKind <= 10u)
					{
