					const unsigned int branchIsValue = isValue;
					const unsigned int branchItValue = itValue;
#else
					const unsigned int branchIsValue = viBackupCycles > 0u &&
						viBackupRegister == lis ? viBackupOldValue : isValue;
					const unsigned int branchItValue = viBackupCycles > 0u &&
						viBackupRegister == lowerIt ? viBackupOldValue : itValue;

