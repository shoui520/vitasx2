					}
				}

				#pragma branch (flatten: never)
				if (immediateLower)
				{
					iValue = lower;
				}
				else if (executeLower && !lowerDiscarded && stopReason == 0u)
				{
					const unsigned int lowerIt = (lower >> 16) & 15u;
					const unsigned int lis = (lower >> 11) & 15u;
					const unsigned int lid = (lower >> 6) & 15u;
					const unsigned int lowerVfFt = (lower >> 16) & 31u;
					const unsigned int lowerVfFs = (lower >> 11) & 31u;
					const unsigned int lowerMask = (lower >> 21) & 15u;
					int imm11 = (int)(lower & 0x7ffu);
					if ((imm11 & 0x400) != 0) imm11 -= 0x800;
					const int imm15 = (int)((lower & 0x7ffu) |
						((lower >> 10) & 0x7800u));
					int imm5 = (int)((lower >> 6) & 0x1fu);
					if ((imm5 & 0x10) != 0) imm5 -= 0x20;
					const unsigned int isValue = vi[lis] & 0xffffu;
					const unsigned int itValue = vi[lowerIt] & 0xffffu;
